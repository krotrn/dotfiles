# Local / secret shell configs
.zshrc.local
*.local

# Editor
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# VS Code — only track User/settings.json
.config/Code/*
!.config/Code/User/
.config/Code/User/*
!.config/Code/User/settings.json


# Antigravity IDE — only track User/settings.json
.config/Antigravity IDE/*
!.config/Antigravity IDE/User/
.config/Antigravity IDE/User/*
!.config/Antigravity IDE/User/settings.json


# VLC runtime state
.config/vlc/vlcrc

# GPU screen recorder
.config/gpu-screen-recorder/restore_token
.config/Antigravity IDE/Network Persistent State
.config/Antigravity IDE/Cache/Cache_Data/index-dir/the-real-index
.config/Code/agent-host/local-endpoint/metadata.json

# glyph shell: files the shell regenerates itself on start
glyph/state/glyph/
.config/demonshot/hypridle.conf
.config/demonshot/kitty.conf
**/__pycache__/

# app state that lives next to configs (history, generated caches, machine ids)
.config/wireshark/recent
.config/wireshark/recent_common
.config/autostart/mimeinfo.cache
.config/turborepo/
.config/uv/
.config/easyeffects/db/
