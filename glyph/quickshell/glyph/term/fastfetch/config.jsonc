// glyph: the rice mark as dots, keys in caps grey, colors — round dots. Colors by ANSI numbers: kitty in the light theme
// swaps 0↔15 and 7↔8, and white on white is not lost. ~/.config/fastfetch links here while glyph (rice) is alive
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "97", "2": "31" },
        "padding": { "top": 1, "left": 2, "right": 6 }
    },
    "display": {
        "separator": "",
        "color": { "keys": "37", "title": "97", "output": "97", "separator": "90" },
        "percent": { "color": { "green": "97", "yellow": "97", "red": "31" } }
    },
    "modules": [
        "break",
        { "type": "title", "color": { "user": "1;97", "at": "37", "host": "1;97" } },
        { "type": "separator", "string": "─", "outputColor": "37" },
        { "type": "os", "key": "OS        " },
        { "type": "kernel", "key": "KERNEL    ", "format": "{release}" },
        { "type": "wm", "key": "WM        ", "format": "{pretty-name}" },
        { "type": "command", "key": "SHELL     ", "text": "echo quickshell · dots" },
        { "type": "terminal", "key": "TERM      ", "format": "{pretty-name}" },
        { "type": "terminalfont", "key": "FONT      " },
        { "type": "uptime", "key": "UPTIME    " },
        { "type": "memory", "key": "MEMORY    " },
        "break",
        { "type": "colors", "symbol": "circle" },
        "break"
    ]
}
